{
    "name": "tequila/proximity",
    "description": "Create PHP proxy objects with ease",
    "type": "symfony-bundle",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Proximity\\": "src/"
        }
    },
    "authors": [
        {
            "name": "petr-buchin",
            "email": "petrbuchyn@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "nette/php-generator": "^4.0",
        "symfony/framework-bundle": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/dependency-injection": ">=8.0",
        "symfony/config": ">=8.0"
    },
    "scripts": {
        "cs": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "cs-check": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer check",
        "tools-update": "composer update -d tools/php-cs-fixer --no-scripts"
    }
}
